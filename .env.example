# Copy to .env and fill in for REAL mode. Mock mode needs neither.
# .env is gitignored — never commit real keys.

# Claude API key (real answer generation). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# HubSpot private-app token (real CRM write-back). Needs scopes:
# crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
# If unset in real mode, CRM records fall back to output/crm_log.json.
HUBSPOT_TOKEN=
